@using Abp.RadzenUI.Infrastructure.Search
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ICommandPaletteManager Manager
@inject CommandPaletteState State
@inject DialogService DialogService
@inject IJSRuntime JSRuntime

@* Headless host: owns the global Ctrl/⌘+K listener and opens the palette as a
   Radzen dialog. The dialog (CommandPaletteDialog) provides the overlay, backdrop,
   centering, Esc and click-away — so no custom shell CSS is needed here. *@

@code {
    bool _open;
    int _openDialogs;
    bool _modalSideDialogOpen;
    DotNetObjectReference<CommandPalette>? _dotNetRef;

    protected override void OnInitialized()
    {
        State.OpenRequested += OpenAsync;
        DialogService.OnOpen += OnDialogOpen;
        DialogService.OnClose += OnDialogClose;
        DialogService.OnSideOpen += OnSideDialogOpen;
        DialogService.OnSideClose += OnSideDialogClose;
    }

    void OnDialogOpen(string? title, Type type, Dictionary<string, object?> parameters, DialogOptions options) =>
        _openDialogs++;

    void OnDialogClose(dynamic? result) => _openDialogs = Math.Max(0, _openDialogs - 1);

    void OnSideDialogOpen(Type type, Dictionary<string, object?> parameters, SideDialogOptions options) =>
        _modalSideDialogOpen = options.ShowMask;

    void OnSideDialogClose(dynamic? result) => _modalSideDialogOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.initialize", _dotNetRef);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OpenFromShortcut() => OpenAsync();

    public async Task OpenAsync()
    {
        // Navigating from the palette makes Radzen close every open dialog, losing what was typed in it.
        // A side panel without mask doesn't block: the menu behind it can navigate away just the same.
        if (_open || _openDialogs > 0 || _modalSideDialogOpen || !Manager.Enabled)
        {
            return;
        }

        _open = true;
        try
        {
            await DialogService.OpenAsync<CommandPaletteDialog>(
                string.Empty,
                parameters: null,
                options: new DialogOptions
                {
                    ShowTitle = false,
                    ShowClose = false,
                    CloseDialogOnOverlayClick = true,
                    CloseDialogOnEsc = true,
                    AutoFocusFirstElement = true,
                    Width = "640px",
                    Top = "12vh",
                    CssClass = "cmdk-dialog",
                });
        }
        finally
        {
            _open = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.OpenRequested -= OpenAsync;
        DialogService.OnOpen -= OnDialogOpen;
        DialogService.OnClose -= OnDialogClose;
        DialogService.OnSideOpen -= OnSideDialogOpen;
        DialogService.OnSideClose -= OnSideDialogClose;

        if (_dotNetRef is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
