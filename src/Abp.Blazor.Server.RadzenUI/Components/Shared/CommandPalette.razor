@using Abp.RadzenUI.Infrastructure.Search
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ICommandPaletteManager Manager
@inject CommandPaletteState State
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Abp.RadzenUI.Localization.AbpRadzenUIResource> TL

<style>
    .cmdk-overlay {
        position: fixed;
        inset: 0;
        z-index: 1200;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 12vh 1rem 1rem;
        background: color-mix(in srgb, var(--rz-base-900, #000) 45%, transparent);
        backdrop-filter: blur(2px);
    }
    .cmdk-panel {
        width: min(640px, 100%);
        max-height: 70vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 0.75rem;
        background: var(--rz-base-background-color, var(--rz-base-0, #fff));
        color: var(--rz-text-color);
        border: 1px solid var(--rz-border-color, color-mix(in srgb, currentColor 15%, transparent));
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    }
    .cmdk-input-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--rz-border-color, color-mix(in srgb, currentColor 12%, transparent));
    }
    .cmdk-input-row .rzi, .cmdk-input-row .rz-icon {
        font-size: 1.25rem;
        opacity: 0.7;
    }
    .cmdk-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        color: inherit;
        font-size: 1rem;
        line-height: 1.5;
    }
    .cmdk-input::placeholder {
        color: color-mix(in srgb, currentColor 50%, transparent);
    }
    .cmdk-kbd {
        font-size: 0.6875rem;
        font-weight: 600;
        padding: 0.1rem 0.4rem;
        border-radius: 0.3rem;
        border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
        opacity: 0.7;
        white-space: nowrap;
    }
    .cmdk-results {
        flex: 1;
        overflow-y: auto;
        padding: 0.35rem 0;
    }
    .cmdk-group-label {
        padding: 0.5rem 1rem 0.25rem;
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        opacity: 0.55;
    }
    .cmdk-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
        border: none;
        background: transparent;
        color: inherit;
        width: 100%;
        text-align: start;
    }
    .cmdk-item:hover,
    .cmdk-item--active {
        background: color-mix(in srgb, var(--rz-primary, #2563eb) 14%, transparent);
    }
    .cmdk-item .rzi, .cmdk-item .rz-icon {
        font-size: 1.25rem;
    }
    .cmdk-item-text {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .cmdk-item-title {
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cmdk-item-desc {
        font-size: 0.75rem;
        opacity: 0.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cmdk-empty {
        padding: 2rem 1rem;
        text-align: center;
        opacity: 0.6;
        font-size: 0.875rem;
    }
    .cmdk-footer {
        display: flex;
        gap: 1rem;
        padding: 0.5rem 1rem;
        border-top: 1px solid var(--rz-border-color, color-mix(in srgb, currentColor 12%, transparent));
        font-size: 0.75rem;
        opacity: 0.65;
    }
    .cmdk-footer .cmdk-kbd {
        margin-inline-end: 0.25rem;
    }

    @@media (max-width: 640.98px) {
        .cmdk-overlay {
            padding: 0;
        }
        .cmdk-panel {
            width: 100%;
            max-height: 100%;
            height: 100%;
            border-radius: 0;
            border: none;
        }
    }
</style>

@if (_open)
{
    <div class="cmdk-overlay" @onclick="CloseAsync">
        <div class="cmdk-panel" @onclick:stopPropagation="true" @onkeydown="HandleKeyDownAsync">
            <div class="cmdk-input-row">
                <RadzenIcon Icon="search" />
                <input id="cmdk-input"
                       class="cmdk-input"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       placeholder="@TL["CommandPalette:Placeholder"]"
                       value="@_keyword"
                       @oninput="OnInputAsync" />
                <span class="cmdk-kbd">Esc</span>
            </div>
            <div class="cmdk-results">
                @if (_flatItems.Count == 0)
                {
                    <div class="cmdk-empty">
                        @(_keyword.Length == 0 ? TL["CommandPalette:Hint"] : TL["CommandPalette:NoResults"])
                    </div>
                }
                else
                {
                    var flatIndex = 0;
                    foreach (var group in _groups)
                    {
                        <div class="cmdk-group-label">@group.DisplayName</div>
                        @foreach (var item in group.Items)
                        {
                            var currentIndex = flatIndex++;
                            <button type="button"
                                    class="@ItemCssClass(currentIndex)"
                                    @onclick="() => ActivateAsync(item)"
                                    @onmouseover="() => _activeIndex = currentIndex">
                                <RadzenIcon Icon="@(item.Icon ?? "chevron_right")" IconColor="@item.IconColor" />
                                <span class="cmdk-item-text">
                                    <span class="cmdk-item-title">@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <span class="cmdk-item-desc">@item.Description</span>
                                    }
                                </span>
                            </button>
                        }
                    }
                }
            </div>
            <div class="cmdk-footer">
                <span><span class="cmdk-kbd">↑↓</span>@TL["CommandPalette:Nav"]</span>
                <span><span class="cmdk-kbd">↵</span>@TL["CommandPalette:Open"]</span>
                <span><span class="cmdk-kbd">Esc</span>@TL["CommandPalette:Close"]</span>
            </div>
        </div>
    </div>
}

@code {
    bool _open;
    string _keyword = string.Empty;
    IReadOnlyList<CommandPaletteResultGroup> _groups = [];
    List<CommandPaletteItem> _flatItems = [];
    int _activeIndex = -1;
    bool _shouldFocus;

    DotNetObjectReference<CommandPalette>? _dotNetRef;
    CancellationTokenSource? _debounceCts;

    protected override void OnInitialized()
    {
        State.OpenRequested += OpenAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.initialize", _dotNetRef);
        }

        if (_shouldFocus)
        {
            _shouldFocus = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.focus", "#cmdk-input");
            }
            catch (JSException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OpenFromShortcut() => OpenAsync();

    public async Task OpenAsync()
    {
        if (!Manager.Enabled)
        {
            return;
        }

        _open = true;
        _keyword = string.Empty;
        _groups = [];
        _flatItems = [];
        _activeIndex = -1;
        _shouldFocus = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task CloseAsync()
    {
        _debounceCts?.Cancel();
        _open = false;
        _keyword = string.Empty;
        _groups = [];
        _flatItems = [];
        _activeIndex = -1;
        await InvokeAsync(StateHasChanged);
    }

    async Task OnInputAsync(ChangeEventArgs e)
    {
        _keyword = e.Value?.ToString() ?? string.Empty;
        await SearchDebouncedAsync();
    }

    async Task SearchDebouncedAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        // Capture the token before the source can be disposed by a newer keystroke.
        // Reading IsCancellationRequested on the captured token stays safe after dispose;
        // reading cts.Token (the source getter) would throw ObjectDisposedException.
        var token = cts.Token;

        try
        {
            await Task.Delay(150, token);

            var groups = await Manager.SearchAsync(_keyword, token);

            // Bail if a newer search superseded this one.
            if (token.IsCancellationRequested || !ReferenceEquals(_debounceCts, cts))
            {
                return;
            }

            _groups = groups;
            _flatItems = groups.SelectMany(static g => g.Items).ToList();
            _activeIndex = _flatItems.Count > 0 ? 0 : -1;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                Move(1);
                break;
            case "ArrowUp":
                Move(-1);
                break;
            case "Enter":
                if (_activeIndex >= 0 && _activeIndex < _flatItems.Count)
                {
                    await ActivateAsync(_flatItems[_activeIndex]);
                }
                break;
            case "Escape":
                await CloseAsync();
                break;
        }
    }

    void Move(int delta)
    {
        if (_flatItems.Count == 0)
        {
            return;
        }

        _activeIndex = (_activeIndex + delta + _flatItems.Count) % _flatItems.Count;
    }

    async Task ActivateAsync(CommandPaletteItem item)
    {
        await CloseAsync();
        NavigationManager.NavigateTo(item.Url, forceLoad: item.ForceLoad);
    }

    string ItemCssClass(int index) =>
        index == _activeIndex ? "cmdk-item cmdk-item--active" : "cmdk-item";

    public async ValueTask DisposeAsync()
    {
        State.OpenRequested -= OpenAsync;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        if (_dotNetRef is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
