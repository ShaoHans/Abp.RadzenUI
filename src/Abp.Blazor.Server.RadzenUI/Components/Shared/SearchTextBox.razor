@*
    List-toolbar search box built from official Radzen parts: a RadzenFormField
    without a floating label (the label truncated long hints such as
    "user name/email/phone"), the hint as placeholder/tooltip, Enter to search,
    and a clear button that resets the keyword and searches again.
*@
@* AllowFloatingLabel=false: with the floating label on, RadzenFormField overwrites the
   child input's placeholder with " " to make room for the label, so the hint vanishes. *@
<RadzenFormField Style="@Style" Variant="Variant.Outlined" AllowFloatingLabel="false" class="abp-search-box">
    <Start>
        <RadzenIcon Icon="search" IconStyle="IconStyle.Secondary" />
    </Start>
    <ChildContent>
        <RadzenTextBox InputSize="InputSize.Small" Value="@Keyword" Placeholder="@PlaceHoder" title="@PlaceHoder" aria-label="@PlaceHoder"
                       @oninput="HandleInput" @onkeydown="HandleKeyDown" />
    </ChildContent>
    <End>
        <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                      Visible="@(!string.IsNullOrEmpty(Keyword))" Click="ClearAsync" />
    </End>
</RadzenFormField>

@code {
    [Parameter]
    public string Style { get; set; } = "width:100%";

    [Parameter]
    public string PlaceHoder { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> KeywordChanged { get; set; }

    [Parameter]
    public string? Keyword { get; set; }

    [Parameter]
    public Func<Task>? SearchAsync { get; set; }

    async Task HandleInput(ChangeEventArgs e)
    {
        Keyword = e.Value?.ToString();
        await KeywordChanged.InvokeAsync(Keyword);
    }

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && SearchAsync is not null)
        {
            await SearchAsync.Invoke();
        }
    }

    async Task ClearAsync()
    {
        Keyword = null;
        await KeywordChanged.InvokeAsync(Keyword);

        if (SearchAsync is not null)
        {
            await SearchAsync.Invoke();
        }
    }
}
