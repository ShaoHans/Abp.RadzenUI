@using Abp.RadzenUI.Infrastructure.Search
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ICommandPaletteManager Manager
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Abp.RadzenUI.Localization.AbpRadzenUIResource> TL
@inject ILogger<CommandPaletteDialog> Logger

<style>
    /* Strip the Radzen dialog's default chrome so the palette sits flush. */
    .cmdk-dialog .rz-dialog-content {
        padding: 0;
    }
    .cmdk-dialog .rz-tabview-panel {
        padding: 0;
    }

    .cmdk-input-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--rz-border-color, color-mix(in srgb, currentColor 12%, transparent));
    }
    .cmdk-input-row .rzi, .cmdk-input-row .rz-icon {
        font-size: 1.25rem;
        opacity: 0.7;
    }
    .cmdk-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        color: inherit;
        font-size: 1rem;
        line-height: 1.5;
    }
    .cmdk-input::placeholder {
        color: color-mix(in srgb, currentColor 50%, transparent);
    }
    .cmdk-kbd {
        font-size: 0.6875rem;
        font-weight: 600;
        padding: 0.1rem 0.4rem;
        border-radius: 0.3rem;
        border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
        opacity: 0.7;
        white-space: nowrap;
    }
    .cmdk-results {
        overflow-y: auto;
        max-height: 46vh;
        padding: 0.35rem 0;
    }
    /* Rows of the previous keyword, kept while searching so the list doesn't flicker. */
    .cmdk-results--stale .cmdk-item {
        opacity: 0.5;
        pointer-events: none;
    }
    .cmdk-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
        border: none;
        background: transparent;
        color: inherit;
        width: 100%;
        text-align: start;
    }
    .cmdk-item:hover,
    .cmdk-item--active {
        background: color-mix(in srgb, var(--rz-primary, #2563eb) 14%, transparent);
    }
    .cmdk-item .rzi, .cmdk-item .rz-icon {
        font-size: 1.25rem;
    }
    .cmdk-item-text {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .cmdk-item-title {
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cmdk-item-desc {
        font-size: 0.75rem;
        opacity: 0.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cmdk-empty {
        padding: 2rem 1rem;
        text-align: center;
        opacity: 0.6;
        font-size: 0.875rem;
    }
    .cmdk-footer {
        display: flex;
        gap: 1rem;
        padding: 0.5rem 1rem;
        border-top: 1px solid var(--rz-border-color, color-mix(in srgb, currentColor 12%, transparent));
        font-size: 0.75rem;
        opacity: 0.65;
    }
    .cmdk-footer .cmdk-kbd {
        margin-inline-end: 0.25rem;
    }
</style>

<div>
    <div class="cmdk-input-row">
        <RadzenIcon Icon="search" />
        <input id="cmdk-input"
               class="cmdk-input"
               type="text"
               autocomplete="off"
               spellcheck="false"
               placeholder="@TL["CommandPalette:Placeholder"]"
               value="@_keyword"
               @oninput="OnInputAsync" />
        <span class="cmdk-kbd">Esc</span>
    </div>

    @if (_tabs.Count > 1)
    {
        @* Not @bind + Change: that renders once with the new tab selected and the old tab's rows. *@
        <RadzenTabs SelectedIndex="_selectedTabIndex"
                    SelectedIndexChanged="OnTabChanged"
                    RenderMode="TabRenderMode.Server">
            <Tabs>
                @foreach (var tab in _tabs)
                {
                    <RadzenTabsItem Text="@tab.DisplayName" Icon="@tab.Icon">
                        @ResultsFragment
                    </RadzenTabsItem>
                }
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        @ResultsFragment
    }

    <div class="cmdk-footer">
        <span><span class="cmdk-kbd">↑↓</span>@TL["CommandPalette:Nav"]</span>
        <span><span class="cmdk-kbd">↵</span>@TL["CommandPalette:Open"]</span>
        <span><span class="cmdk-kbd">Esc</span>@TL["CommandPalette:Close"]</span>
    </div>
</div>

@code {
    enum SearchState { Ready, Searching, Failed }

    SearchState _state;
    string _keyword = string.Empty;
    List<CommandPaletteTab> _tabs = [];
    string _activeTabKey = string.Empty;
    int _selectedTabIndex;
    List<CommandPaletteItem> _items = [];
    int _activeIndex = -1;
    bool _shouldFocus;

    CancellationTokenSource? _searchCts;
    DotNetObjectReference<CommandPaletteDialog>? _dotNetRef;

    // _items can only be selected while Ready; otherwise they belong to an older keyword.
    bool CanSelect => _state == SearchState.Ready;

    RenderFragment ResultsFragment =>@<div class="@ResultsCssClass">
        @if (_items.Count == 0)
        {
            <div class="cmdk-empty">
                @GetEmptyText()
            </div>
        }
        else
        {
            @for (var i = 0; i < _items.Count; i++)
            {
                var index = i;
                var item = _items[index];
                <button type="button"
                        class="@ItemCssClass(index)"
                        @onclick="() => ActivateAsync(item)"
                        @onmouseover="() => _activeIndex = index">
                    <RadzenIcon Icon="@(item.Icon ?? "chevron_right")" IconColor="@item.IconColor" />
                    <span class="cmdk-item-text">
                        <span class="cmdk-item-title">@item.Title</span>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <span class="cmdk-item-desc">@item.Description</span>
                        }
                    </span>
                </button>
            }
        }
    </div>;

    protected override void OnInitialized()
    {
        _tabs = Manager.GetTabs().ToList();
        if (_tabs.Count == 0)
        {
            DialogService.Close();
            return;
        }

        _selectedTabIndex = 0;
        _activeTabKey = _tabs[0].Key;
        _shouldFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.setDialog", _dotNetRef);
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }

        if (_shouldFocus)
        {
            _shouldFocus = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.focus", "#cmdk-input");
            }
            catch (JSException)
            {
            }
        }
    }

    async Task OnInputAsync(ChangeEventArgs e)
    {
        var previous = _keyword.Trim();
        _keyword = e.Value?.ToString() ?? string.Empty;

        // The query is trimmed, so a space at either end changes nothing.
        if (_keyword.Trim() != previous)
        {
            await SearchAsync(debounce: true);
        }
    }

    // Must not await the search: RadzenTabs focuses its tab list when this returns. Returning at
    // once puts that before our render, so OnAfterRenderAsync has the last word and focuses the input.
    void OnTabChanged(int index)
    {
        if (index < 0 || index >= _tabs.Count)
        {
            return;
        }

        _selectedTabIndex = index;
        _activeTabKey = _tabs[index].Key;
        _items = [];
        _shouldFocus = true;
        _ = SearchAsync(debounce: false); // handles its own errors and re-renders when done
    }

    async Task SearchAsync(bool debounce)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        // Capture the token before a newer keystroke/tab switch can dispose the source.
        var token = cts.Token;

        // All of this has to happen before the first await, which is where Blazor renders.
        _activeIndex = -1;
        if (_keyword.Trim().Length < Manager.MinKeywordLength)
        {
            _items = [];
            _state = SearchState.Ready;
            return;
        }

        _state = SearchState.Searching;

        try
        {
            if (debounce)
            {
                await Task.Delay(150, token);
            }

            var items = await Manager.SearchAsync(_activeTabKey, _keyword, token);

            // Bail if a newer search superseded this one.
            if (token.IsCancellationRequested)
            {
                return;
            }

            _items = items.ToList();
            _state = items is CommandPaletteSearchFailure ? SearchState.Failed : SearchState.Ready;
            _activeIndex = _items.Count > 0 ? 0 : -1;
        }
        catch (Exception) when (token.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            // The dialog is outside the layout's error boundary: anything escaping ends the circuit.
            Logger.LogError(ex, "Command palette search failed.");
            _items = [];
            _state = SearchState.Failed;
        }

        await InvokeAsync(StateHasChanged);
    }

    // Invoked from the JS capture-phase keydown listener while this dialog is open, so
    // navigation works regardless of which element (input, RadzenTabs header) has focus.
    // Esc is handled by the dialog itself (CloseDialogOnEsc).
    [JSInvokable]
    public async Task HandleKey(string key)
    {
        switch (key)
        {
            case "ArrowDown":
                Move(1);
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowUp":
                Move(-1);
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
                if (CanSelect && _activeIndex >= 0 && _activeIndex < _items.Count)
                {
                    await ActivateAsync(_items[_activeIndex]);
                }
                break;
        }
    }

    void Move(int delta)
    {
        if (!CanSelect || _items.Count == 0)
        {
            return;
        }

        _activeIndex = (_activeIndex + delta + _items.Count) % _items.Count;
    }

    async Task ActivateAsync(CommandPaletteItem item)
    {
        // A click can still arrive from a row rendered before the keyword or tab changed.
        if (!CanSelect || !_items.Contains(item))
        {
            return;
        }

        DialogService.Close();
        NavigationManager.NavigateTo(item.Url, forceLoad: item.ForceLoad);
        await Task.CompletedTask;
    }

    string ItemCssClass(int index) =>
        CanSelect && index == _activeIndex ? "cmdk-item cmdk-item--active" : "cmdk-item";

    string ResultsCssClass => CanSelect ? "cmdk-results" : "cmdk-results cmdk-results--stale";

    string GetEmptyText()
    {
        if (_state == SearchState.Failed)
        {
            return TL["CommandPalette:Failed"];
        }

        if (_state == SearchState.Searching)
        {
            return TL["CommandPalette:Searching"];
        }

        var length = _keyword.Trim().Length;
        if (length == 0)
        {
            return TL["CommandPalette:Hint"];
        }

        return length < Manager.MinKeywordLength
            ? TL["CommandPalette:MinLength", Manager.MinKeywordLength]
            : TL["CommandPalette:NoResults"];
    }

    public async ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();

        if (_dotNetRef is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("abpRadzenCommandPalette.clearDialog");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
