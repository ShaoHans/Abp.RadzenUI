@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Options
@using Abp.RadzenUI.Infrastructure.Utils
@inject IHostEnvironment Env
@inject ThemeService ThemeService
@inject IOptions<AbpRadzenUIOptions> AbpRadzenUIOptions
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider

<!DOCTYPE html>
<html lang="en" dir="@(ThemeService.RightToLeft == true ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* ?v=<content hash>: these files are served without Cache-Control, so browsers reuse a
       stale copy after an upgrade (layout CSS out of sync with the Razor markup). *@
    <link href="@WithFileVersion("/_content/AbpRadzen.Blazor.Server.UI/css/site.css")" rel="stylesheet" />
    <link href="@WithFileVersion("/_content/AbpRadzen.Blazor.Server.UI/app.css")" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <link rel="preload" href="_content/AbpRadzen.Blazor.Server.UI/fonts/MaterialSymbolsOutlined.woff2" as="font" type="font/woff2">
    <RadzenTheme Theme="@_theme" @rendermode="InteractiveServer" />
</head>
<body class="rz-scrollbars">
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>
                An unhandled exception has occurred. See browser dev tools for details.
            </text>
        }
        else
        {
            <text>
                An error has occurred. This app may no longer respond until reloaded.
            </text>
        }
        <a href="/" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_content/AbpRadzen.Blazor.Server.UI/js/avatar-uploader.js"></script>
    <script src="_content/AbpRadzen.Blazor.Server.UI/js/fullscreen.js"></script>
    <script src="_content/AbpRadzen.Blazor.Server.UI/js/menu-rail.js"></script>
    <script src="_content/AbpRadzen.Blazor.Server.UI/js/page-size-preference.js"></script>
    <script src="@WithFileVersion("/_content/AbpRadzen.Blazor.Server.UI/js/command-palette.js")"></script>
    <script src="_content/AbpRadzen.Blazor.Server.UI/js/file-download.js"></script>
    <script>
        window.abpRadzenViewport = window.abpRadzenViewport || {
            isMobile: function (maxWidth) {
                const width = Number.isFinite(maxWidth) ? maxWidth : 768;
                return window.matchMedia(`(max-width: ${width}px)`).matches;
            }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script async src="_content/AbpRadzen.Blazor.Server.UI/js/highlight.pack.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>
</html>

@code {
    string _theme = "material-dark";

    /// <summary>
    /// Appends a content-hash version (same mechanism as asp-append-version) so a changed
    /// stylesheet gets a new URL. Unchanged path when the file can't be found.
    /// </summary>
    string WithFileVersion(string path)
    {
        var pathBase = HttpContextAccessor.HttpContext?.Request.PathBase ?? PathString.Empty;
        return FileVersionProvider.AddFileVersionToPath(pathBase, pathBase.Add(path).Value!);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = AbpRadzenUICookieHelper.GetThemeCookie(HttpContextAccessor.HttpContext!)
                ?? AbpRadzenUIOptions.Value.Theme.Default;
    }

}
