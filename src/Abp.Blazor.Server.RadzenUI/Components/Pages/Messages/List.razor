@page "/messages"
@using Abp.RadzenUI.Application.Contracts.Messages
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable
@inherits AbpRadzenUIComponentBase

<PageTitle>@L["PageTitle:Messages"]</PageTitle>

<RadzenCard Variant="Variant.Outlined" class="rz-mb-3 rz-p-3">
    <RadzenRow Gap="1rem" RowGap="0.75rem">
        <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
            <RadzenTextBox InputSize="InputSize.Small" Placeholder="@L["Message:TitlePlaceholder"]"
                           @bind-Value="_keyword"
                           Style="width: 100%;"
                           Name="MessageTitle" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
            <RadzenDropDown InputSize="InputSize.Small" TValue="MessageReadStatus?"
                            Data="@_readStatusOptions"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Value="@_readStatus"
                            Change="OnReadStatusChangedAsync"
                            Style="width: 100%;"
                            Placeholder="@L["Message:All"]"
                            AllowClear="true" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
            <RadzenDropDown InputSize="InputSize.Small" TValue="string"
                            Data="@_messageTypeOptions"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Value="@_selectedMessageType"
                            Change="OnMessageTypeChangedAsync"
                            Style="width: 100%;"
                            Placeholder="@L["Message:TypePlaceholder"]"
                            AllowClear="true" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" SizeLG="2">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="@L["Btn:Search"]" ButtonStyle="ButtonStyle.Primary" Icon="search" Click="SearchAsync" Size="ButtonSize.Small" />
                <RadzenButton Text="@L["Btn:Reset"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Shade="Shade.Lighter" Icon="refresh" Click="ResetFiltersAsync" Size="ButtonSize.Small" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

<LocalizedDataGrid @ref="_grid"
                   Data="@_messages"
                   TItem="UserMessageDto"
                   AllowPaging="true"
                   AllowSorting="true"
                   Density="Density.Compact"
                   AllowColumnResize="true"
                   AllowRowSelectOnRowClick="false"
                   PagerHorizontalAlign="HorizontalAlign.Center"
                   PageSize="@_defaultPageSize"
                   ShowPagingSummary="true"
                   LoadData="LoadDataAsync"
                   Count="@_totalCount"
                   IsLoading="@_isLoading"
                   SelectionMode="DataGridSelectionMode.Multiple"
                   @bind-Value="_selectedMessages">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenButton Icon="done_all"
                          Text="@L["Message:BatchMarkAsRead"]"
                          Size="ButtonSize.Small"
                          Disabled="@(_selectedMessages.Count == 0)"
                          Click="BatchMarkAsReadAsync" />
            <RadzenButton Icon="mark_email_read"
                          Text="@L["Message:MarkAllAsRead"]"
                          Size="ButtonSize.Small" Variant="Variant.Flat" Shade="Shade.Lighter"
                          Click="MarkAllAsReadAsync" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Width="50px" Sortable="false" Filterable="false">
            <HeaderTemplate>
                <RadzenCheckBox TabIndex="-1"
                                TriState="false"
                                TValue="bool?"
                                Value="@SelectAllValue"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Select all messages" })"
                                Change="OnSelectAllChanged" />
            </HeaderTemplate>
            <Template Context="data">
                <RadzenCheckBox TabIndex="-1"
                                TriState="false"
                                TValue="bool"
                                Value="@(_selectedMessages.Contains(data))"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Select message" })"
                                Change="@(_ => _grid.SelectRow(data))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(UserMessageDto.Title)" Title="@L["DisplayName:UserMessage.Title"]" Sortable="false" MinWidth="360px">
            <Template Context="message">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.NoWrap">
                    <RadzenBadge Text="@(message.IsRead ? L["Message:ReadBadge"] : L["Message:UnreadBadge"])"
                                 BadgeStyle="@(message.IsRead ? BadgeStyle.Base : BadgeStyle.Warning)" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Style="text-transform:none" />
                    <SideDialogLink Text="@message.Title" OnClick="@(async () => await OpenDetailAsync(message))" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(UserMessageDto.MessageType)" Title="@L["DisplayName:UserMessage.MessageType"]" Width="180px" />
        <RadzenDataGridColumn Property="@nameof(UserMessageDto.ReadTime)" Title="@L["DisplayName:UserMessage.ReadTime"]" Width="150px">
            <Template Context="message">
                <TextOrDash Text="@(message.ReadTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(UserMessageDto.CreationTime)" Title="@L["DisplayName:UserMessage.ReceivedTime"]" Width="150px">
            <Template Context="message">
                @message.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</LocalizedDataGrid>