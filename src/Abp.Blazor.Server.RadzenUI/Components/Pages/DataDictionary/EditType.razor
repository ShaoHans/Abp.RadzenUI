@using Abp.RadzenUI.Application.Contracts.DataDictionaries
@using Abp.RadzenUI.DataDictionaries
@using Volo.Abp.AspNetCore.Components
@inherits AbpRadzenUIComponentBase

<RadzenTemplateForm TItem="UpdateDataDictionaryTypeDto" Data=@DialogFromOption.Model Submit="@(model => DialogFromOption.SubmitAsync(model, () => InvokeAsync(StateHasChanged)))"
                    Style="max-height:calc(100vh - 200px); display: flex; flex-direction:column">
    <DialogFormLayout CancelClick="DialogFromOption.OnCancel" IsSaving="@DialogFromOption.IsSaving">
        <RadzenRow Gap="1rem" RowGap="1rem" class="rz-p-1 rz-mb-4">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RadzenLabel Text="@L["DisplayName:DataDictionaryType.Code"]" />
                    </div>
                    <RadzenTextBox Value="@Code" Disabled="true" Style="width: 100%;" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["DisplayName:DataDictionaryType.Name"]" Component="Name" />
                    </div>
                    <RadzenTextBox Name="Name" @bind-Value=@DialogFromOption.Model.Name Style="width: 100%;" MaxLength="DataDictionaryTypeConsts.MaxNameLength" />
                    <RadzenRequiredValidator Component="Name" Text="@L.Required("DisplayName:DataDictionaryType.Name")" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RadzenLabel Text="@L["DisplayName:DataDictionaryType.Description"]" Component="Description" />
                    </div>
                    <RadzenTextArea Name="Description" @bind-Value=@DialogFromOption.Model.Description Style="width: 100%;" Rows="3" MaxLength="DataDictionaryTypeConsts.MaxDescriptionLength" />
                </RadzenStack>
            </RadzenColumn>
            @if (CanEditShared)
            {
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                        <RadzenSwitch Name="IsShared" @bind-Value=@DialogFromOption.Model.IsShared />
                        <RadzenStack Gap="0.125rem">
                            <RadzenLabel Text="@L["DisplayName:DataDictionaryType.IsShared"]" Component="IsShared" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@L["DataDictionaryForm:IsSharedHint"]</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                }
        </RadzenRow>
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter]
    public DialogFromOption<UpdateDataDictionaryTypeDto> DialogFromOption { get; set; } = default!;

    [Parameter]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public bool CanEditShared { get; set; }

    public EditType()
    {
        LocalizationResource = typeof(AbpRadzenUIResource);
    }
}
