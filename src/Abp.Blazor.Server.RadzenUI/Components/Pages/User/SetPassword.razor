@using Abp.RadzenUI.Application.Contracts.Users
@using Abp.RadzenUI.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Components
@using Volo.Abp.Identity
@using Volo.Abp.Identity.Localization
@inject IUserManagementAppService UserManagementAppService
@inject DialogService DialogService
@inject IStringLocalizer<AbpRadzenUIResource> IL
@inherits AbpRadzenUIComponentBase

<RadzenTemplateForm TItem="SetPasswordModel" Data="@_model" Submit="@(_ => SaveAsync())">
    <DialogFormLayout CancelClick="@(() => DialogService.Close(false))" IsSaving="@_isSaving" BodyStyle="overflow:visible;">
        <RadzenStack Gap="1.5rem" class="rz-py-2">
            <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RequiredMark />
                    <RadzenLabel Text="@IL["DisplayName:NewPassword"]" Component="NewPassword" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenPassword Name="NewPassword" @bind-Value="_model.NewPassword" Style="display:block; width:100%;"
                                    MaxLength="IdentityUserConsts.MaxPasswordLength" />
                    <RadzenRequiredValidator Component="NewPassword" Text="@IL.Required("DisplayName:NewPassword")" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RequiredMark />
                    <RadzenLabel Text="@IL["DisplayName:ConfirmPassword"]" Component="ConfirmPassword" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenPassword Name="ConfirmPassword" @bind-Value="_model.ConfirmPassword" Style="display:block; width:100%;"
                                    MaxLength="IdentityUserConsts.MaxPasswordLength" />
                    <RadzenCompareValidator Component="ConfirmPassword" Value="@_model.NewPassword"
                                            Operator="CompareOperator.Equal" Text="@IL["User:PasswordMismatch"]" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid UserId { get; set; }

    readonly SetPasswordModel _model = new();
    bool _isSaving;

    public SetPassword()
    {
        LocalizationResource = typeof(IdentityResource);
    }

    async Task SaveAsync()
    {
        try
        {
            _isSaving = true;
            await UserManagementAppService.SetPasswordAsync(UserId, new IdentityUserSetPasswordInput
            {
                NewPassword = _model.NewPassword
            });

            await Notify.Success(IL["User:SetPasswordSuccess"]);
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            await Notify.Error(ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    class SetPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
