@using Volo.Abp.Identity

<RowActionMenu Actions="@_actions" OnAction="HandleActionAsync" MoreTitle="@MoreTitle" />

@code {
    const string EditKey = "edit";
    const string ViewPermissionsKey = "view-permissions";
    const string ManagePermissionsKey = "manage-permissions";
    const string SetPasswordKey = "set-password";
    const string LockKey = "lock";
    const string UnlockKey = "unlock";
    const string DeleteKey = "delete";

    [Parameter, EditorRequired]
    public IdentityUserDto User { get; set; } = default!;

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public bool CanManagePermissions { get; set; }

    [Parameter]
    public bool CanDelete { get; set; }

    [Parameter]
    public bool CanManageLockout { get; set; }

    [Parameter]
    public bool CanSetPassword { get; set; }

    /// <summary>Whether the user is currently locked out (lockout end date is in the future).</summary>
    bool IsLocked => User.LockoutEnd.HasValue && User.LockoutEnd.Value > DateTimeOffset.UtcNow;

    [Parameter, EditorRequired]
    public string EditTitle { get; set; } = default!;

    [Parameter, EditorRequired]
    public string PermissionsTitle { get; set; } = default!;

    [Parameter, EditorRequired]
    public string PermissionsVisualizerTitle { get; set; } = default!;

    [Parameter, EditorRequired]
    public string DeleteTitle { get; set; } = default!;

    [Parameter]
    public string LockTitle { get; set; } = default!;

    [Parameter]
    public string UnlockTitle { get; set; } = default!;

    [Parameter]
    public string SetPasswordTitle { get; set; } = default!;

    /// <summary>Tooltip of the overflow menu shown when no primary action is permitted.</summary>
    [Parameter]
    public string MoreTitle { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback<IdentityUserDto> OnEdit { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<IdentityUserDto> OnManagePermissions { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<IdentityUserDto> OnViewPermissions { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<IdentityUserDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<IdentityUserDto> OnLock { get; set; }

    [Parameter]
    public EventCallback<IdentityUserDto> OnUnlock { get; set; }

    [Parameter]
    public EventCallback<IdentityUserDto> OnSetPassword { get; set; }

    List<RowAction> _actions = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _actions = [];

        if (CanEdit)
        {
            _actions.Add(new RowAction(EditKey, EditTitle, "edit", IsPrimary: true));
        }

        if (CanManagePermissions)
        {
            _actions.Add(new RowAction(ViewPermissionsKey, PermissionsVisualizerTitle, "visibility"));
            _actions.Add(new RowAction(ManagePermissionsKey, PermissionsTitle, "productivity"));
        }

        if (CanSetPassword)
        {
            _actions.Add(new RowAction(SetPasswordKey, SetPasswordTitle, "password"));
        }

        if (CanManageLockout)
        {
            _actions.Add(IsLocked
                ? new RowAction(UnlockKey, UnlockTitle, "lock_open")
                : new RowAction(LockKey, LockTitle, "lock"));
        }

        if (CanDelete)
        {
            _actions.Add(new RowAction(DeleteKey, DeleteTitle, "delete", Colors.Danger));
        }
    }

    Task HandleActionAsync(string key)
    {
        return key switch
        {
            EditKey => OnEdit.InvokeAsync(User),
            ViewPermissionsKey => OnViewPermissions.InvokeAsync(User),
            ManagePermissionsKey => OnManagePermissions.InvokeAsync(User),
            SetPasswordKey => OnSetPassword.InvokeAsync(User),
            LockKey => OnLock.InvokeAsync(User),
            UnlockKey => OnUnlock.InvokeAsync(User),
            DeleteKey => OnDelete.InvokeAsync(User),
            _ => Task.CompletedTask,
        };
    }
}
