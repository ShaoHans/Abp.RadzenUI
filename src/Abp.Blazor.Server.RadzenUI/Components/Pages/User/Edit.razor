@using Abp.RadzenUI.Application.Contracts.Organizations
@using Abp.RadzenUI.Components.ObjectExtending
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Volo.Abp.Identity
@using Volo.Abp.Identity.Localization
@inject IIdentityUserAppService UserAppService
@inherits AbpRadzenUIComponentBase

<RadzenTemplateForm TItem="IdentityUserUpdateDto" Data=@DialogFromOption.Model Submit="@(model => DialogFromOption.SubmitAsync(model, () => InvokeAsync(StateHasChanged)))" Style="max-height:calc(100vh - 200px); display: flex;flex-direction:column">
    <DialogFormLayout CancelClick="@DialogFromOption.OnCancel" IsSaving="@DialogFromOption.IsSaving">
        <RadzenRow Gap="1.5rem" RowGap="1.5rem" class="rz-p-1 rz-mb-4">
            <RadzenColumn Size="12" SizeMD="@(HasManagePermissionsPermission ? 7 : 12)">
                <UserInfoFields TDto="IdentityUserUpdateDto" Model="@DialogFromOption.Model">
                    <PasswordContent>
                        <div>
                            <RadzenLabel Text="@L["DisplayName:Password"]" Component="Password" />
                        </div>
                        <RadzenPassword Name="Password" @bind-Value=@DialogFromOption.Model.Password Style="width: 100%;" MaxLength="IdentityUserConsts.MaxPasswordLength"
                                        Placeholder="@IL["UserForm:PasswordKeepHint"]" autocomplete="new-password" />
                    </PasswordContent>
                </UserInfoFields>
            </RadzenColumn>
            @if (HasManagePermissionsPermission)
            {
                <RadzenColumn Size="12" SizeMD="5">
                    <RadzenCard Variant="Variant.Filled" class="rz-p-4">
                        <UserRolesPane Roles="@roles" @bind-SelectedRoleNames="DialogFromOption.Model.RoleNames" />
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter] public DialogFromOption<IdentityUserUpdateDto> DialogFromOption { get; set; } = default!;
    [Parameter] public Guid UserId { get; set; }
    [Inject] public IStringLocalizer<AbpRadzenUIResource> IL { get; set; } = default!;
    [Inject] public IOrganizationUnitAppService OuAppService { get; set; } = default!;

    protected bool HasManagePermissionsPermission { get; set; }
    IReadOnlyList<UserRoleOption> roles = [];

    public Edit()
    {
        LocalizationResource = typeof(IdentityResource);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        HasManagePermissionsPermission = await AuthorizationService.IsGrantedAsync(
            IdentityPermissions.Users.ManagePermissions
        );

        if (!HasManagePermissionsPermission)
        {
            return;
        }

        var roleNames = (await UserAppService.GetAssignableRolesAsync())
            .Items?.Select(r => r.Name).ToArray()
            ?? [];

        var roleNamesInOu = (await OuAppService.GetRoleNamesAsync(UserId)).Items ?? [];

        roles = roleNames
            .Union(roleNamesInOu)
            .OrderBy(r => r)
            .Select(r => new UserRoleOption(r, roleNamesInOu.Contains(r)))
            .ToList();
    }
}
