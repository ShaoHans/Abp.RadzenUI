@using Abp.RadzenUI.Application.Contracts.LocalizationTexts
@using Abp.RadzenUI.Localization
@using Microsoft.Extensions.Localization
@inject DialogService DialogService
@inject IStringLocalizer<AbpRadzenUIResource> L

<RadzenTemplateForm TItem="EditResult" Data="@_model" Submit="@(model => DialogService.Close(model))"
                    Style="max-height:calc(100vh - 200px); display: flex; flex-direction:column">
    <DialogFormLayout CancelClick="OnCancel">
        <RadzenRow Gap="1rem" RowGap="1rem" class="rz-p-1 rz-mb-4">
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RadzenLabel Text="@L["Localization:Key"]" />
                    </div>
                    <RadzenTextBox Value="@Item.Key" Disabled="true" Style="width: 100%;" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RadzenLabel Text="@L["Localization:BaseValue"]" />
                    </div>
                    <RadzenTextArea Value="@(Item.BaseValue ?? string.Empty)" Disabled="true" Style="width: 100%;" Rows="3" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                 AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenLabel Text="@L["Localization:OverrideValue"]" Component="Value" />
                        @if (CanReset)
                        {
                            <RadzenButton ButtonType="ButtonType.Button" Text="@L["Localization:Reset"]" Icon="restart_alt"
                                          ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="OnReset" />
                        }
                    </RadzenStack>
                    <RadzenTextArea Name="Value" @bind-Value="_model.Value" Style="width: 100%;" Rows="3" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter]
    public LocalizationTextItemDto Item { get; set; } = default!;

    [Parameter]
    public bool CanReset { get; set; }

    private readonly EditResult _model = new();

    protected override void OnInitialized()
    {
        _model.Value = Item.OverrideValue ?? Item.BaseValue ?? string.Empty;
    }

    private void OnReset() => DialogService.Close(new EditResult { Reset = true });

    private void OnCancel() => DialogService.Close(null);

    public class EditResult
    {
        public bool Reset { get; set; }

        public string? Value { get; set; }
    }
}
