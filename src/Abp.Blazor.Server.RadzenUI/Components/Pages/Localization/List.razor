@page "/localization-texts"
@using Abp.RadzenUI.Application.Contracts.LocalizationTexts
@using Abp.RadzenUI.Permissions
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(RadzenUIPermissions.Localization.Default)]
@inherits AbpRadzenUIComponentBase

<PageTitle>@L["Menu:Localization"]</PageTitle>

<LocalizedDataGrid @ref="_grid" Data="@_items" TItem="LocalizationTextItemDto"
                AllowPaging="true" AllowSorting="true" Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Center"
                ShowPagingSummary="true" LoadData="LoadDataAsync"
                Count="@_totalCount" IsLoading="@_isLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenDropDown InputSize="InputSize.Small" TValue="string" Data="@_resources" @bind-Value="_selectedResource"
                            TextProperty="@nameof(LocalizationResourceInfoDto.Name)"
                            ValueProperty="@nameof(LocalizationResourceInfoDto.Name)"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="@L["Localization:Resource"]" title="@L["Localization:Resource"]"
                            Style="width:220px;max-width:100%"
                            Change="@(async () => await ReloadAsync())" />
            <RadzenDropDown InputSize="InputSize.Small" TValue="string" Data="@_cultures" @bind-Value="_selectedCulture"
                            TextProperty="@nameof(LocalizationCultureDto.DisplayName)"
                            ValueProperty="@nameof(LocalizationCultureDto.CultureName)"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="@L["Localization:Culture"]" title="@L["Localization:Culture"]"
                            Style="width:200px;max-width:100%"
                            Change="@(async () => await ReloadAsync())" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap" Gap="0.375rem">
                @* RadzenSwitch has no size and every theme has its own geometry, so scale it as a whole. *@
                <RadzenSwitch @bind-Value="_onlyOverridden" Change="@(async (bool _) => await ReloadAsync())" Style="zoom:0.75" />
                <RadzenText Text="@L["Localization:OnlyOverridden"]" TextStyle="TextStyle.Body2" Style="margin:0" />
            </RadzenStack>
            <SearchTextBox Style="width:280px;max-width:100%;margin-inline-start:auto"
                           PlaceHoder="@L["Localization:SearchPlaceholder"]"
                           @bind-Keyword="_filter" SearchAsync="ReloadAsync" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(LocalizationTextItemDto.Key)"
                              Title="@L["Localization:Key"]" Width="280px">
            <Template Context="item">
                <TextOrDash Text="@item.Key" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(LocalizationTextItemDto.BaseValue)"
                              Title="@L["Localization:BaseValue"]" Sortable="false" MinWidth="200px">
            <Template Context="item">
                <TextOrDash Text="@item.BaseValue" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(LocalizationTextItemDto.OverrideValue)"
                              Title="@L["Localization:OverrideValue"]" Sortable="false" MinWidth="200px">
            <Template Context="item">
                @if (item.IsOverridden)
                {
                    <span title="@item.OverrideValue" style="color:var(--rz-primary); font-weight:600">@item.OverrideValue</span>
                }
                else
                {
                    <TextOrDash Text="@null" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="@L["Localization:Status"]" Width="110px" Sortable="false" TextAlign="TextAlign.Center">
            <Template Context="item">
                <RadzenBadge Text="@L["Localization:OverriddenBadge"]" Visible="item.IsOverridden" BadgeStyle="BadgeStyle.Info"
                             Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Style="text-transform:none" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="@UL["Actions"]" Width="100px" Sortable="false" TextAlign="TextAlign.Center">
            <Template Context="item">
                <RowActionMenu Actions="@RowActions"
                               OnAction="@((string _) => OpenEditDialogAsync(item))"
                               MoreTitle="@UL["Actions"]" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</LocalizedDataGrid>
