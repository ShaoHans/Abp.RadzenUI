@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Components
@using Volo.Abp.Identity.Localization
@using Volo.Abp.SettingManagement
@using Volo.Abp.SettingManagement.Localization
@inherits AbpRadzenUIComponentBase
@inject IStringLocalizer<IdentityResource> IL

<RadzenTemplateForm TItem="SendTestEmailVM" Data=@SendTestEmailInput Submit="SendTestEmailAsync" Style="max-height:calc(100vh - 200px); display: flex;flex-direction:column">
    <DialogFormLayout SaveIcon="send" CancelClick="@(() => { DialogService.Close(); })" SaveText="@L["Send"]" IsSaving="@_isSending">
        <RadzenRow Gap="1rem" RowGap="1rem" class="rz-p-1 rz-mb-4">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["SenderEmailAddress"]" Component="@nameof(SendTestEmailVM.SenderEmailAddress)" />
                    </div>
                    <RadzenTextBox Name="@nameof(SendTestEmailVM.SenderEmailAddress)" @bind-Value="@SendTestEmailInput.SenderEmailAddress" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="@nameof(SendTestEmailVM.SenderEmailAddress)" Text="@L.Required("SenderEmailAddress")" />
                    <RadzenEmailValidator Component="@nameof(SendTestEmailVM.SenderEmailAddress)" Text="@IL["Volo.Abp.Identity:InvalidEmail", SendTestEmailInput.SenderEmailAddress ?? string.Empty]" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["TargetEmailAddress"]" Component="@nameof(SendTestEmailVM.TargetEmailAddress)" />
                    </div>
                    <RadzenTextBox Name="@nameof(SendTestEmailVM.TargetEmailAddress)" @bind-Value="@SendTestEmailInput.TargetEmailAddress" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="@nameof(SendTestEmailVM.TargetEmailAddress)" Text="@L.Required("TargetEmailAddress")" />
                    <RadzenEmailValidator Component="@nameof(SendTestEmailVM.TargetEmailAddress)" Text="@IL["Volo.Abp.Identity:InvalidEmail", SendTestEmailInput.TargetEmailAddress ?? string.Empty]" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["Subject"]" Component="@nameof(SendTestEmailVM.Subject)" />
                    </div>
                    <RadzenTextBox Name="@nameof(SendTestEmailVM.Subject)" @bind-Value="@SendTestEmailInput.Subject" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="@nameof(SendTestEmailVM.Subject)" Text="@L.Required("Subject")" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["Body"]" Component="@nameof(SendTestEmailVM.Body)" />
                    </div>
                    <RadzenTextArea Name="@nameof(SendTestEmailVM.Body)" @bind-Value="@SendTestEmailInput.Body" Rows="4" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="@nameof(SendTestEmailVM.Body)" Text="@L.Required("Body")" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter]
    public string DefaultFromAddress { get; set; } = string.Empty;

    [Inject]
    protected IEmailSettingsAppService EmailSettingsAppService { get; set; } = default!;

    [Inject]
    protected DialogService DialogService { get; set; } = default!;

    public SendTestEmailVM SendTestEmailInput { get; set; } = new();

    bool _isSending;

    public SendTestEmail()
    {
        LocalizationResource = typeof(AbpSettingManagementResource);
    }

    protected override void OnInitialized()
    {
        SendTestEmailInput = new SendTestEmailVM
        {
            SenderEmailAddress = DefaultFromAddress,
            TargetEmailAddress = CurrentUser.Email ?? string.Empty,
            Subject = L["TestEmailSubject", new Random().Next(1000, 9999)],
            Body = L["TestEmailBody"]
        };
        base.OnInitialized();
    }

    protected virtual async Task SendTestEmailAsync()
    {
        try
        {
            _isSending = true;
            await EmailSettingsAppService.SendTestEmailAsync(
                ObjectMapper.Map<SendTestEmailVM, SendTestEmailInput>(SendTestEmailInput)
            );
            await Notify.Success(L["SentSuccessfully"]);
            DialogService.Close();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _isSending = false;
        }
    }
}
