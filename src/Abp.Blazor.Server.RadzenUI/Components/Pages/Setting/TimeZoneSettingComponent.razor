@using Volo.Abp.AspNetCore.Components
@using Microsoft.Extensions.Localization
@inherits AbpRadzenUIComponentBase
@inject IStringLocalizer<AbpRadzenUIResource> UI

<RadzenTemplateForm TItem="UpdateTimezoneSettingsVm" Data="@TimezoneSettings" Submit="UpdateSettingsAsync">
    <RadzenStack Gap="1.5rem" class="rz-p-1" Style="max-width: 480px;">
        <RadzenStack Gap="0.25rem">
            <div>
                <RequiredMark />
                <RadzenLabel Text="@L["DisplayName:Timezone"]" Component="@nameof(UpdateTimezoneSettingsVm.Timezone)" />
            </div>
            <RadzenDropDown @bind-Value="@TimezoneSettings.Timezone" Placeholder="@UI["Setting:Timezone.Placeholder"]"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Data="@TimezoneSettings.TimeZoneItems" TextProperty="Name" ValueProperty="Value"
                            Name="@nameof(UpdateTimezoneSettingsVm.Timezone)" Style="width: 100%;" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@UI["Setting:Timezone.Hint"]</RadzenText>
        </RadzenStack>
        <div>
            <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="@L["Save"]" />
        </div>
    </RadzenStack>
</RadzenTemplateForm>
