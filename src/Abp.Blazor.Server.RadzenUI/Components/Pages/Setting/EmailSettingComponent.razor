@using Volo.Abp.AspNetCore.Components
@using Volo.Abp.Identity.Localization
@using Microsoft.Extensions.Localization
@inherits AbpRadzenUIComponentBase
@inject IStringLocalizer<IdentityResource> IL
@inject IStringLocalizer<AbpRadzenUIResource> UI

<RadzenTemplateForm TItem="UpdateEmailSettingsVm" Data=@EmailSettings Submit="UpdateSettingsAsync">
    <RadzenStack Gap="1.5rem" class="rz-p-1" Style="max-width: 720px;">
        <div>
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-color-primary rz-mb-3">@UI["Setting:Email.SenderSection"]</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <div>
                            <RequiredMark />
                            <RadzenLabel Text="@L["DefaultFromDisplayName"]" Component="@nameof(UpdateEmailSettingsVm.DefaultFromDisplayName)" />
                        </div>
                        <RadzenTextBox Name="@nameof(UpdateEmailSettingsVm.DefaultFromDisplayName)" @bind-Value="@EmailSettings.DefaultFromDisplayName" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="@nameof(UpdateEmailSettingsVm.DefaultFromDisplayName)" Text="@L.Required("DefaultFromDisplayName")" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <div>
                            <RequiredMark />
                            <RadzenLabel Text="@L["DefaultFromAddress"]" Component="@nameof(UpdateEmailSettingsVm.DefaultFromAddress)" />
                        </div>
                        <RadzenTextBox Name="@nameof(UpdateEmailSettingsVm.DefaultFromAddress)" @bind-Value="@EmailSettings.DefaultFromAddress" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="@nameof(UpdateEmailSettingsVm.DefaultFromAddress)" Text="@L.Required("DefaultFromAddress")" />
                        <RadzenEmailValidator Component="@nameof(UpdateEmailSettingsVm.DefaultFromAddress)" Text="@IL["Volo.Abp.Identity:InvalidEmail", EmailSettings.DefaultFromAddress ?? string.Empty]" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </div>

        <div>
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-color-primary rz-mb-3">@UI["Setting:Email.ServerSection"]</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenStack Gap="0.25rem">
                        <div>
                            <RequiredMark />
                            <RadzenLabel Text="@L["SmtpHost"]" Component="@nameof(UpdateEmailSettingsVm.SmtpHost)" />
                        </div>
                        <RadzenTextBox Name="@nameof(UpdateEmailSettingsVm.SmtpHost)" @bind-Value="@EmailSettings.SmtpHost" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="@nameof(UpdateEmailSettingsVm.SmtpHost)" Text="@L.Required("SmtpHost")" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack Gap="0.25rem">
                        <div>
                            <RequiredMark />
                            <RadzenLabel Text="@L["SmtpPort"]" Component="@nameof(UpdateEmailSettingsVm.SmtpPort)" />
                        </div>
                        <RadzenNumeric TValue="int" Name="@nameof(UpdateEmailSettingsVm.SmtpPort)" @bind-Value="@EmailSettings.SmtpPort" Min="1" Max="65535" ShowUpDown="false" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="@nameof(UpdateEmailSettingsVm.SmtpPort)" Text="@L.Required("SmtpPort")" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                        <RadzenSwitch Name="@nameof(UpdateEmailSettingsVm.SmtpEnableSsl)" @bind-Value="@EmailSettings.SmtpEnableSsl" />
                        <RadzenStack Gap="0.125rem">
                            <RadzenLabel Text="@L["SmtpEnableSsl"]" Component="@nameof(UpdateEmailSettingsVm.SmtpEnableSsl)" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@UI["Setting:Email.EnableSslHint"]</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </div>

        <div>
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-color-primary rz-mb-3">@UI["Setting:Email.AuthSection"]</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                        <RadzenSwitch Name="@nameof(UpdateEmailSettingsVm.SmtpUseDefaultCredentials)" @bind-Value="@EmailSettings.SmtpUseDefaultCredentials" />
                        <RadzenStack Gap="0.125rem">
                            <RadzenLabel Text="@L["SmtpUseDefaultCredentials"]" Component="@nameof(UpdateEmailSettingsVm.SmtpUseDefaultCredentials)" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@UI["Setting:Email.UseDefaultCredentialsHint"]</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                @if (!EmailSettings.SmtpUseDefaultCredentials)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.25rem">
                            <div>
                                <RequiredMark />
                                <RadzenLabel Text="@L["SmtpUserName"]" Component="@nameof(UpdateEmailSettingsVm.SmtpUserName)" />
                            </div>
                            <RadzenTextBox Name="@nameof(UpdateEmailSettingsVm.SmtpUserName)" @bind-Value="@EmailSettings.SmtpUserName" Style="width: 100%;" autocomplete="off" />
                            <RadzenRequiredValidator Component="@nameof(UpdateEmailSettingsVm.SmtpUserName)" Text="@L.Required("SmtpUserName")" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.25rem">
                            <div>
                                <RadzenLabel Text="@L["SmtpPassword"]" Component="@nameof(UpdateEmailSettingsVm.SmtpPassword)" />
                            </div>
                            @* ABP keeps the stored password when this is left blank, so it is not required. *@
                            <RadzenPassword Name="@nameof(UpdateEmailSettingsVm.SmtpPassword)" @bind-Value="@EmailSettings.SmtpPassword" Style="width: 100%;"
                                            Placeholder="@UI["Setting:Email.PasswordKeepHint"]" autocomplete="new-password" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenStack Gap="0.25rem">
                            <div>
                                <RadzenLabel Text="@L["SmtpDomain"]" Component="@nameof(UpdateEmailSettingsVm.SmtpDomain)" />
                            </div>
                            <RadzenTextBox Name="@nameof(UpdateEmailSettingsVm.SmtpDomain)" @bind-Value="@EmailSettings.SmtpDomain" Style="width: 100%;" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@UI["Setting:Email.DomainHint"]</RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                }
            </RadzenRow>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="@L["Save"]" />
            @if (HasSendTestEmailPermission)
            {
                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Icon="send"
                              Text="@L["SendTestEmail"]" Click="OpenSendTestEmailModalAsync" />
            }
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>
