@using Volo.Abp.Account.Localization
@using Volo.Abp.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Abp.RadzenUI.Application.Contracts.Settings
@inherits AbpRadzenUIComponentBase
@inject IStringLocalizer<AccountResource> IL

<RadzenTemplateForm TItem="AccountSettingsDto" Data=@AccountSettings Submit="UpdateSettingsAsync">
    <RadzenStack Gap="1.5rem" class="rz-p-1" Style="max-width: 720px;">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <RadzenSwitch Name="@nameof(AccountSettingsDto.IsSelfRegistrationEnabled)" @bind-Value="@AccountSettings.IsSelfRegistrationEnabled" />
                <RadzenStack Gap="0.125rem">
                    <RadzenLabel Text="@IL["DisplayName:Abp.Account.IsSelfRegistrationEnabled"]" Component="@nameof(AccountSettingsDto.IsSelfRegistrationEnabled)" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@IL["Description:Abp.Account.IsSelfRegistrationEnabled"]</RadzenText>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <RadzenSwitch Name="@nameof(AccountSettingsDto.EnableLocalLogin)" @bind-Value="@AccountSettings.EnableLocalLogin" />
                <RadzenStack Gap="0.125rem">
                    <RadzenLabel Text="@IL["DisplayName:Abp.Account.EnableLocalLogin"]" Component="@nameof(AccountSettingsDto.EnableLocalLogin)" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@IL["Description:Abp.Account.EnableLocalLogin"]</RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
        <div>
            <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="@L["Save"]" />
        </div>
    </RadzenStack>
</RadzenTemplateForm>
