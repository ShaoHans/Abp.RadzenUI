@page "/tenantManagement/tenants"
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.ObjectExtending
@using Volo.Abp.TenantManagement
@attribute [Authorize(TenantManagementPermissions.Tenants.Default)]
@inherits AbpCrudPageBase<ITenantAppService, TenantDto, Guid, GetTenantsInput, TenantCreateDto, TenantUpdateDto>

<PageTitle>@L["Tenants"]</PageTitle>

<LocalizedDataGrid @ref="_grid" Data="@_entities" AllowPaging="true" AllowSorting="true" Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Center" PageSize="@_defaultPageSize"
                ShowPagingSummary="@_showPagerSummary" LoadData="LoadDataAsync"
                Count="@_totalCount" IsLoading="@_isLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            @if (HasCreatePermission)
            {
                <RadzenButton Icon="add" Text="@L["NewTenant"]" Size="ButtonSize.Small" Click="@(async () => await OpenCreateDialogAsync<Create>(L["NewTenant"], () => { return SetDialogOptions(); }))" />
            }
            <SearchTextBox Style="width:280px;max-width:100%;margin-inline-start:auto" PlaceHoder="@L["DisplayName:TenantName"]" @bind-Keyword="@GetListInput.Filter" SearchAsync="@_grid.Reload" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TenantDto.Id)" Title="ID" Width="80px" Visible="false" />
        <RadzenDataGridColumn Property="@nameof(TenantDto.Name)" Title="@L["DisplayName:TenantName"]" MinWidth="200px" />
        @(RadzenColumnHelper.ExtraPropertiesColumns<TenantDto>(_extraColumns, StringLocalizerFactory))
        <RadzenDataGridColumn Title="@L["Actions"]" Width="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
            <Template>
                <RowActionMenu Actions="@BuildRowActions()"
                               OnAction="@(key => HandleRowActionAsync(key, context))"
                               MoreTitle="@L["Actions"]" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</LocalizedDataGrid>
