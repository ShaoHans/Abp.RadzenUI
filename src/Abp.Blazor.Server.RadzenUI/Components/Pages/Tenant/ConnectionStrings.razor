@using Abp.RadzenUI.Application.Contracts.Tenants
@inject ITenantConnectionStringAppService ConnectionStringAppService
@inject DialogService DialogService
@inherits AbpRadzenUIComponentBase

<RadzenStack Style="max-height:calc(100vh - 200px);">
    <DialogFormLayout ShowSave="false" CancelText="@L["Close"]" CancelIcon="close"
                      CancelClick="() => DialogService.Close(false)">
        <RadzenStack Gap="1rem" class="rz-p-1 rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-color-primary rz-m-0">
                    @L["ConnectionString:Manage"] (@_connectionStrings.Count)
                </RadzenText>
                @if (!_showForm)
                {
                    <RadzenButton Icon="add" Text="@L["ConnectionString:Add"]" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="ShowAddForm" />
                }
            </RadzenStack>

            <RadzenDataGrid @ref="_grid" Data="@_connectionStrings" TItem="TenantConnectionStringDto"
                            AllowSorting="false" Density="Density.Compact">
                <EmptyTemplate>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-align-center rz-p-4 rz-text-secondary-color">
                        @L["ConnectionString:Empty"]
                    </RadzenText>
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(TenantConnectionStringDto.Name)"
                                          Title="@L["ConnectionString:Name"]" Width="160px" />
                    <RadzenDataGridColumn Property="@nameof(TenantConnectionStringDto.Value)"
                                          Title="@L["ConnectionString:Value"]">
                        <Template>
                            <span title="@context.Value">@MaskConnectionString(context.Value)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@L["Actions"]" Width="96px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template>
                            <RadzenButton Icon="edit" title="@L["Btn:Edit"]" Variant="Variant.Text"
                                          Size="ButtonSize.ExtraSmall" Click="@(() => EditConnectionString(context))" />
                            <RadzenButton Icon="delete" title="@L["Btn:Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                          Size="ButtonSize.ExtraSmall" Click="@(() => DeleteConnectionStringAsync(context))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            @if (_showForm)
            {
                <RadzenCard Variant="Variant.Filled" class="rz-p-4">
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">
                            @(_isEditing ? L["ConnectionString:Edit"] : L["ConnectionString:Add"])
                        </RadzenText>
                        <RadzenStack Gap="0.25rem">
                            <div>
                                <RequiredMark />
                                <RadzenLabel Text="@L["ConnectionString:Name"]" Component="CsName" />
                            </div>
                            <RadzenTextBox Name="CsName" @bind-Value="_editingName" Disabled="@_isEditing"
                                           Style="width: 100%;" Placeholder="Default" autocomplete="off" />
                        </RadzenStack>
                        <RadzenStack Gap="0.25rem">
                            <div>
                                <RequiredMark />
                                <RadzenLabel Text="@L["ConnectionString:Value"]" Component="CsValue" />
                            </div>
                            <RadzenTextArea Name="CsValue" @bind-Value="_editingValue" Style="width: 100%;" Rows="3"
                                            Placeholder="Server=...;Database=...;" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Text="@L["Cancel"]"
                                          Size="ButtonSize.Small" Click="CancelForm" />
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="save" Text="@L["Save"]"
                                          Size="ButtonSize.Small" Click="SaveConnectionStringAsync" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </DialogFormLayout>
</RadzenStack>

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    RadzenDataGrid<TenantConnectionStringDto> _grid = default!;
    List<TenantConnectionStringDto> _connectionStrings = [];
    bool _showForm;
    bool _isEditing;
    string _editingName = string.Empty;
    string _editingValue = string.Empty;

    public ConnectionStrings()
    {
        LocalizationResource = typeof(AbpRadzenUIResource);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadConnectionStringsAsync();
    }

    async Task LoadConnectionStringsAsync()
    {
        try
        {
            _connectionStrings = await ConnectionStringAppService.GetListAsync(TenantId);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    void ShowAddForm()
    {
        _isEditing = false;
        _editingName = string.Empty;
        _editingValue = string.Empty;
        _showForm = true;
    }

    void EditConnectionString(TenantConnectionStringDto cs)
    {
        _isEditing = true;
        _editingName = cs.Name;
        _editingValue = cs.Value;
        _showForm = true;
    }

    void CancelForm()
    {
        _showForm = false;
        _editingName = string.Empty;
        _editingValue = string.Empty;
    }

    async Task SaveConnectionStringAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingName) || string.IsNullOrWhiteSpace(_editingValue))
        {
            await Notify.Warn(L["ConnectionString:NameAndValueRequired"]);
            return;
        }

        try
        {
            await ConnectionStringAppService.AddOrUpdateAsync(TenantId, new TenantConnectionStringDto
            {
                Name = _editingName.Trim(),
                Value = _editingValue.Trim()
            });
            await Notify.Success(L["SavedSuccessfully"]);
            CancelForm();
            await LoadConnectionStringsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    async Task DeleteConnectionStringAsync(TenantConnectionStringDto cs)
    {
        var result = await DialogService.Confirm(
            L["ConnectionString:DeleteConfirm", cs.Name],
            L["Btn:Delete"],
            new ConfirmOptions { OkButtonText = L["Yes"], CancelButtonText = L["Cancel"] });

        if (result == true)
        {
            try
            {
                await ConnectionStringAppService.DeleteAsync(TenantId, cs.Name);
                await Notify.Success(L["DeletedSuccessfully"]);
                await LoadConnectionStringsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await HandleErrorAsync(ex);
            }
        }
    }

    static string MaskConnectionString(string value)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= 20)
            return value;

        return string.Concat(value.AsSpan(0, 20), "...");
    }
}
