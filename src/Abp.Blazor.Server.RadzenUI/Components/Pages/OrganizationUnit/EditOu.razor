@using Abp.RadzenUI.Application.Contracts.Organizations
@using Volo.Abp.AspNetCore.Components
@using Volo.Abp.Identity
@inherits AbpRadzenUIComponentBase

<RadzenTemplateForm TItem="OrganizationUnitUpdateDto" Data=@DialogFromOption.Model Submit="@(model => DialogFromOption.SubmitAsync(model, () => InvokeAsync(StateHasChanged)))" Style="max-height:calc(100vh - 200px); display: flex;flex-direction:column">
    <DialogFormLayout CancelClick="DialogFromOption.OnCancel" IsSaving="@DialogFromOption.IsSaving">
        <RadzenRow Gap="1rem" RowGap="1rem" class="rz-p-1 rz-mb-4">
            <RadzenColumn Size="12">
                <RadzenStack Gap="0.25rem">
                    <div>
                        <RequiredMark />
                        <RadzenLabel Text="@L["DisplayName:Ou.DisplayName"]" Component="@nameof(DialogFromOption.Model.DisplayName)" />
                    </div>
                    <RadzenTextBox Name="@nameof(DialogFromOption.Model.DisplayName)" @bind-Value=@DialogFromOption.Model.DisplayName Style="width: 100%;" MaxLength="OrganizationUnitConsts.MaxDisplayNameLength" />
                    <RadzenRequiredValidator Component="@nameof(DialogFromOption.Model.DisplayName)" Text="@L.Required("DisplayName:Ou.DisplayName")" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </DialogFormLayout>
</RadzenTemplateForm>


@code {
    [Parameter]
    public DialogFromOption<OrganizationUnitUpdateDto> DialogFromOption { get; set; } = default!;

    public EditOu()
    {
        LocalizationResource = typeof(AbpRadzenUIResource);
    }
}
