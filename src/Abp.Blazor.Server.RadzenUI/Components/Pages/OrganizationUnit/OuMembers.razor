@using Abp.RadzenUI.Application.Contracts.Organizations
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Identity
@using Volo.Abp.Users
@inherits AbpRadzenUIComponentBase

@if (SelectedOu == null)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-py-12">
        <RadzenIcon Icon="lan" Style="font-size:48px; color:var(--rz-text-secondary-color)" />
        <RadzenText TextStyle="TextStyle.Body1" Style="color:var(--rz-text-secondary-color)" Text="@IL["Ou:Member.Tooltip"]" />
    </RadzenStack>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center"
                 Gap="0.5rem" class="rz-my-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem">
            <RadzenIcon Icon="lan" IconStyle="IconStyle.Secondary" />
            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin:0" Text="@SelectedOu.DisplayName" />
            <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Primary" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" />
        </RadzenStack>
        <RadzenButton Text="@IL["Ou:Member.Add"]" Icon="add" Size="ButtonSize.Small" Click="@OpenSeleteMemberDialogAsync" />
    </RadzenStack>

    <LocalizedDataGrid @ref="_grid" Data="@_entities" AllowPaging="true" AllowSorting="true" Density="Density.Compact"
                       PagerHorizontalAlign="HorizontalAlign.Center" PageSize="@_defaultPageSize" Style="height:calc(100vh - 275px)"
                       PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" LoadData="LoadDataAsync"
                       Count="@_totalCount" IsLoading="@_isLoading">
        <HeaderTemplate>
            <SearchTextBox PlaceHoder="@($"{L["DisplayName:UserName"]}/{L["DisplayName:Email"]}")"
                           @bind-Keyword="@GetListInput.Filter" SearchAsync="@_grid.Reload" Style="width:280px;max-width:100%" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(IdentityUserDto.UserName)" Title="@L["DisplayName:UserName"]" Width="200px">
                <Template>
                    @{
                        var fullName = string.Format(IL["User:FullNameFormat"], context.Name, context.Surname).Trim();
                    }
                    <RadzenStack Gap="0" Style="min-width:0">
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" title="@context.UserName"
                                    Style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@context.UserName</RadzenText>
                        @if (!string.IsNullOrEmpty(fullName) && fullName != context.UserName)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" title="@fullName"
                                        Style="color:var(--rz-text-secondary-color);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@fullName</RadzenText>
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(IdentityUserDto.Email)" Title="@L["DisplayName:Email"]" MinWidth="200px">
                <Template>
                    <TextOrDash Text="@context.Email" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@L["Actions"]" Width="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                <Template>
                    <RowActionMenu Actions="@_rowActions" MoreTitle="@L["Actions"]"
                                   OnAction="@(_ => OpenDeleteConfirmDialogAsync(context.Id, context.UserName))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </LocalizedDataGrid>
}

@code {
    /// <summary>Only "remove from unit" is offered, rendered by RowActionMenu as a single icon button.</summary>
    IReadOnlyList<RowAction> _rowActions => [new RowAction("delete", L["Delete"], "delete", Colors.Danger)];
}
