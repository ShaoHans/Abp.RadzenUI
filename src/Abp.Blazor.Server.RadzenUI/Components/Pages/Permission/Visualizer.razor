@using Volo.Abp.PermissionManagement
@using Volo.Abp.PermissionManagement.Localization
@using Microsoft.Extensions.Localization
@using Abp.RadzenUI.Localization
@using Abp.RadzenUI.Permissions
@inject IPermissionAppService PermissionAppService
@inject IStringLocalizer<AbpRadzenUIResource> UI
@inherits AbpRadzenUIComponentBase

<div class="permission-visualizer">
<RadzenStack Gap="1rem" Style="@ContainerStyle">
    @if (_isLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height:260px;">
            <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
        </RadzenStack>
    }
    else
    {
        <RadzenStack Gap="1rem" Style="height:100%; min-height:0;" class="rz-p-1">
            <RadzenRow Gap="0.75rem" RowGap="0.75rem">
                <RadzenColumn Size="6" SizeMD="3">
                    @SummaryCard(UI["PermissionVisualizer:Total"], _totalCount, null, null)
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    @SummaryCard(UI["PermissionVisualizer:Granted"], _grantedCount, null, null)
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    @SummaryCard(UI["PermissionVisualizer:NotGranted"], _notGrantedCount, _notGrantedCount > 0 ? "rz-color-danger" : null, null)
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    @SummaryCard(UI["PermissionVisualizer:ExternalGranted"], _externalGrantedCount, null, _externalSourcesText)
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Style="flex:1; min-width:220px; max-width:400px;">
                    <RadzenTextBox Value="@_keyword" ValueChanged="@OnKeywordChanged" Immediate="true"
                                   Placeholder="@UI["PermissionVisualizer:SearchPlaceholder"]"
                                   Style="width:100%;" autocomplete="off" />
                    @if (!string.IsNullOrEmpty(_keyword))
                    {
                        <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                      title="@UI["Btn:Reset"]" Click="ClearKeyword" />
                    }
                </RadzenStack>
                <RadzenSelectBar TValue="PermissionVisualFilter" Data="@_filterOptions"
                                 TextProperty="@nameof(FilterOption.Text)" ValueProperty="@nameof(FilterOption.Value)"
                                 Value="@_filter" ValueChanged="@OnFilterChanged" Size="ButtonSize.Small" />
            </RadzenStack>

            <RadzenTabs @bind-SelectedIndex="_activeTab">
                <Tabs>
                    <RadzenTabsItem Text="@UI["PermissionVisualizer:Groups"]">
                        <RadzenDataGrid Data="@_filteredGroups" TItem="PermissionGroupVm" AllowSorting="true"
                                        RowClick="@(args => OpenGroupInTree(args.Data!))">
                            <EmptyTemplate>
                                @EmptyState(UI["PermissionVisualizer:NoPermissions"])
                            </EmptyTemplate>
                            <Columns>
                                <RadzenDataGridColumn Property="@nameof(PermissionGroupVm.DisplayName)" Title="@UI["PermissionVisualizer:Group"]" Width="220px" />
                                <RadzenDataGridColumn Title="@UI["PermissionVisualizer:Coverage"]" Sortable="false">
                                    <Template>
                                        @{
                                            var stats = GetGroupStats(context);
                                            var percent = stats.Total == 0 ? 0 : (int)Math.Round(stats.Granted * 100m / stats.Total);
                                        }
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                            <RadzenProgressBar Value="@percent" ShowValue="false" Style="flex:1;"
                                                               ProgressBarStyle="@(percent == 100 ? ProgressBarStyle.Success : ProgressBarStyle.Primary)" />
                                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="white-space:nowrap;">
                                                @stats.Granted/@stats.Total
                                                <span class="rz-text-secondary-color">· @percent%</span>
                                            </RadzenText>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Width="56px" Sortable="false" TextAlign="TextAlign.Center">
                                    <Template>
                                        <RadzenIcon Icon="chevron_right" class="rz-text-secondary-color" title="@UI["PermissionVisualizer:Tree"]" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="@UI["PermissionVisualizer:Tree"]">
                        @if (_filteredGroups.Count == 0)
                        {
                            @EmptyState(UI["PermissionVisualizer:NoPermissions"])
                        }
                        else
                        {
                            <RadzenTabs TabPosition="TabPosition.Left" @bind-SelectedIndex="_treeGroupIndex">
                                <Tabs>
                                    @for (var i = 0; i < _filteredGroups.Count; i++)
                                    {
                                        var index = i;
                                        <RadzenTabsItem Text="@GetTabShowName(_filteredGroups[index])">
                                            @* Resolve the group when the panel renders: RadzenTabs renders panels from the
                                               previous ChildContent, and filtering creates new group objects each time. *@
                                            @if (index >= _filteredGroups.Count)
                                            {
                                                return;
                                            }
                                            @{ var group = _filteredGroups[index]; }
                                            @if (group.TreeItems.Count == 0)
                                            {
                                                @EmptyState(UI["PermissionVisualizer:NoPermissions"])
                                            }
                                            else
                                            {
                                                <RadzenTree Data="@group.TreeItems">
                                                    <RadzenTreeLevel Text="(i => GetPermissionShownName(((PermissionTreeItemVm)i).Permission))"
                                                                     ChildrenProperty="Children"
                                                                     Expanded="(i => true)"
                                                                     HasChildren="(i => ((PermissionTreeItemVm)i).Children.Count > 0)">
                                                        <Template>
                                                            @if (context.Value is PermissionTreeItemVm treeItem)
                                                            {
                                                                var granted = treeItem.Permission.IsGranted;
                                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                                    <RadzenIcon Icon="@(granted ? "check_circle" : "block")"
                                                                                class="@(granted ? "rz-color-success" : "rz-text-disabled-color")"
                                                                                title="@(granted ? UI["PermissionVisualizer:Granted"] : UI["PermissionVisualizer:NotGranted"])" />
                                                                    <RadzenText TextStyle="TextStyle.Body2" class="@(granted ? "rz-m-0" : "rz-m-0 rz-text-disabled-color")">@context.Text</RadzenText>
                                                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-tertiary-color">@treeItem.Permission.Name</RadzenText>
                                                                    @foreach (var provider in GetOwnExternalProviders(treeItem))
                                                                    {
                                                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="@GetProviderText(provider)" />
                                                                    }
                                                                </RadzenStack>
                                                            }
                                                        </Template>
                                                    </RadzenTreeLevel>
                                                </RadzenTree>
                                            }
                                        </RadzenTabsItem>
                                    }
                                </Tabs>
                            </RadzenTabs>
                        }
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenStack>
    }
</RadzenStack>
</div>

@code {
    [Parameter]
    public string ProviderName { get; set; } = default!;

    [Parameter]
    public string ProviderKey { get; set; } = default!;

    private static readonly HashSet<string> SystemMgmtGroupNames = new(StringComparer.OrdinalIgnoreCase)
    {
        "AbpIdentity",
        "AbpTenantManagement",
        "SettingManagement",
        "FeatureManagement",
        RadzenUIPermissions.GroupName
    };

    readonly List<FilterOption> _filterOptions = [];
    List<PermissionGroupVm> _groups = [];
    List<PermissionGroupVm> _filteredGroups = [];
    string? _keyword;
    PermissionVisualFilter _filter = PermissionVisualFilter.All;
    int _totalCount;
    int _grantedCount;
    int _notGrantedCount;
    int _externalGrantedCount;
    string? _externalSourcesText;
    bool _isLoading = true;
    int _activeTab;
    int _treeGroupIndex;

    const int TreeTabIndex = 1;

    // Only the tree tab needs a fixed height (its tree owns the single scrollbar, see site.css);
    // the groups table is usually a few rows, so that tab just takes the height it needs.
    string ContainerStyle => !_isLoading && _activeTab == TreeTabIndex
        ? "height:calc(100vh - 180px); min-height:480px;"
        : "max-height:calc(100vh - 180px);";

    public Visualizer()
    {
        LocalizationResource = typeof(AbpPermissionManagementResource);
    }

    protected override async Task OnInitializedAsync()
    {
        _filterOptions.AddRange(
        [
            new FilterOption(PermissionVisualFilter.All, UI["PermissionVisualizer:Filter.AllShort"]),
            new FilterOption(PermissionVisualFilter.Granted, UI["PermissionVisualizer:Granted"]),
            new FilterOption(PermissionVisualFilter.NotGranted, UI["PermissionVisualizer:NotGranted"]),
            new FilterOption(PermissionVisualFilter.ExternalGranted, UI["PermissionVisualizer:ExternalGranted"]),
        ]);

        var result = await PermissionAppService.GetAsync(ProviderName, ProviderKey);
        _groups = BuildGroups(result);
        UpdateSummary();
        ApplyFilter();
        _isLoading = false;
    }

    List<PermissionGroupVm> BuildGroups(GetPermissionListResultDto result)
    {
        var groups = new List<PermissionGroupVm>();
        var sysMgmtApiGroups = result.Groups
            .Where(g => SystemMgmtGroupNames.Contains(g.Name))
            .ToList();
        var otherApiGroups = result.Groups
            .Where(g => !SystemMgmtGroupNames.Contains(g.Name))
            .ToList();

        if (sysMgmtApiGroups.Count > 0)
        {
            var mergedTreeItems = new List<PermissionTreeItemVm>();
            foreach (var group in sysMgmtApiGroups)
            {
                mergedTreeItems.AddRange(GenerateTree(group.Permissions, null, 0, null));
            }

            groups.Add(new PermissionGroupVm
            {
                Name = "SystemManagement",
                DisplayName = UI["Permission:SystemGroupName"],
                TreeItems = mergedTreeItems
            });
        }

        foreach (var group in otherApiGroups)
        {
            groups.Add(new PermissionGroupVm
            {
                Name = group.Name,
                DisplayName = group.DisplayName,
                TreeItems = GenerateTree(group.Permissions, null, 0, null)
            });
        }

        return groups;
    }

    List<PermissionTreeItemVm> GenerateTree(List<PermissionGrantInfoDto> allPermissions, string? parentName, int depth, PermissionTreeItemVm? parent)
    {
        var treeItems = new List<PermissionTreeItemVm>();
        var subPermissions = allPermissions.Where(p => p.ParentName == parentName);

        foreach (var item in subPermissions)
        {
            var treeItem = new PermissionTreeItemVm(depth, item);
            treeItem.SetParent(parent);
            treeItem.Children = GenerateTree(allPermissions, item.Name, depth + 1, treeItem);
            treeItems.Add(treeItem);
        }

        return treeItems;
    }

    void UpdateSummary()
    {
        var permissions = _groups.SelectMany(x => x.Expand()).Select(x => x.Permission).ToList();
        _totalCount = permissions.Count;
        _grantedCount = permissions.Count(x => x.IsGranted);
        _notGrantedCount = _totalCount - _grantedCount;
        _externalGrantedCount = permissions.Count(HasExternalProvider);

        // "42 from other sources" says little when it equals the granted count; naming the
        // sources (e.g. "Role: admin") tells the admin where the permissions actually come from.
        var sources = permissions
            .SelectMany(GetExternalProviders)
            .Select(GetProviderText)
            .Distinct()
            .ToList();
        _externalSourcesText = sources.Count switch
        {
            0 => null,
            <= MaxSourcesShown => string.Join(", ", sources),
            _ => UI["PermissionVisualizer:SourcesMore", string.Join(", ", sources.Take(MaxSourcesShown)), sources.Count]
        };
    }

    const int MaxSourcesShown = 2;

    void OnKeywordChanged(string? value)
    {
        _keyword = value;
        ApplyFilter();
    }

    void ClearKeyword() => OnKeywordChanged(null);

    void OnFilterChanged(PermissionVisualFilter value)
    {
        _filter = value;
        ApplyFilter();
    }

    void OpenGroupInTree(PermissionGroupVm group)
    {
        var index = _filteredGroups.IndexOf(group);
        _treeGroupIndex = index < 0 ? 0 : index;
        _activeTab = TreeTabIndex;
    }

    void ApplyFilter()
    {
        _filteredGroups = _groups
            .Select(FilterGroup)
            .Where(x => x.TreeItems.Count > 0)
            .ToList();

        if (_treeGroupIndex >= _filteredGroups.Count)
        {
            _treeGroupIndex = 0;
        }
    }

    PermissionGroupVm FilterGroup(PermissionGroupVm group)
    {
        return new PermissionGroupVm
        {
            Name = group.Name,
            DisplayName = group.DisplayName,
            TreeItems = group.TreeItems
                .Select(FilterTree)
                .Where(x => x is not null)
                .Cast<PermissionTreeItemVm>()
                .ToList()
        };
    }

    PermissionTreeItemVm? FilterTree(PermissionTreeItemVm item)
    {
        var children = item.Children
            .Select(FilterTree)
            .Where(x => x is not null)
            .Cast<PermissionTreeItemVm>()
            .ToList();

        if (!MatchesFilter(item.Permission) && children.Count == 0)
        {
            return null;
        }

        var clone = new PermissionTreeItemVm(item.Depth, item.Permission)
        {
            Children = children
        };

        foreach (var child in clone.Children)
        {
            child.SetParent(clone);
        }

        return clone;
    }

    bool MatchesFilter(PermissionGrantInfoDto permission)
    {
        var matchesState = _filter switch
        {
            PermissionVisualFilter.Granted => permission.IsGranted,
            PermissionVisualFilter.NotGranted => !permission.IsGranted,
            PermissionVisualFilter.ExternalGranted => HasExternalProvider(permission),
            _ => true
        };

        if (!matchesState)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_keyword))
        {
            return true;
        }

        return permission.Name.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
               || permission.DisplayName.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
               || permission.GrantedProviders.Any(x =>
                   x.ProviderName.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                   || x.ProviderKey.Contains(_keyword, StringComparison.OrdinalIgnoreCase));
    }

    (int Total, int Granted, int ExternalGranted) GetGroupStats(PermissionGroupVm group)
    {
        var permissions = group.Expand().Select(x => x.Permission).ToList();
        return (
            permissions.Count,
            permissions.Count(x => x.IsGranted),
            permissions.Count(HasExternalProvider)
        );
    }

    string GetTabShowName(PermissionGroupVm group)
    {
        var stats = GetGroupStats(group);
        return $"{group.DisplayName} ({stats.Granted}/{stats.Total})";
    }

    string GetPermissionShownName(PermissionGrantInfoDto permission)
    {
        return permission.DisplayName;
    }

    IEnumerable<ProviderInfoDto> GetExternalProviders(PermissionGrantInfoDto permission)
    {
        return permission.GrantedProviders.Where(x => x.ProviderName != ProviderName);
    }

    bool HasExternalProvider(PermissionGrantInfoDto permission)
    {
        return GetExternalProviders(permission).Any();
    }

    /// <summary>
    /// External providers not already shown on the parent node, so a role that grants a
    /// whole branch is labelled once instead of on every child.
    /// </summary>
    IEnumerable<ProviderInfoDto> GetOwnExternalProviders(PermissionTreeItemVm item)
    {
        var own = GetExternalProviders(item.Permission);
        if (item.Parent is null)
        {
            return own;
        }

        var inherited = GetExternalProviders(item.Parent.Permission)
            .Select(p => (p.ProviderName, p.ProviderKey))
            .ToHashSet();
        return own.Where(p => !inherited.Contains((p.ProviderName, p.ProviderKey)));
    }

    string GetProviderText(ProviderInfoDto provider) => PermissionProviderText.Format(UI, provider);

    RenderFragment<string> EmptyState => text =>
        @<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" Style="height:100%; min-height:260px;">
            <RadzenIcon Icon="policy" Style="font-size:2.5rem;color:var(--rz-text-disabled-color);" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">@text</RadzenText>
        </RadzenStack>;

    RenderFragment SummaryCard(string title, int value, string? valueClass, string? note) =>
        @<RadzenCard Variant="Variant.Outlined" class="rz-p-3" Style="height:100%;">
            <RadzenStack Gap="0.125rem">
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.Div" class="@($"rz-m-0 {valueClass}")">@value</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-secondary-color">@title</RadzenText>
                @if (!string.IsNullOrEmpty(note))
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-text-tertiary-color" title="@note"
                                Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@note</RadzenText>
                }
            </RadzenStack>
        </RadzenCard>;

    record FilterOption(PermissionVisualFilter Value, string Text);

    enum PermissionVisualFilter
    {
        All,
        Granted,
        NotGranted,
        ExternalGranted
    }
}
