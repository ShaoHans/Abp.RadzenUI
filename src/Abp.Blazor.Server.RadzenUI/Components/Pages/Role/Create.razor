@using Volo.Abp.AspNetCore.Components
@using Volo.Abp.Identity
@using Volo.Abp.Identity.Localization
@inherits AbpRadzenUIComponentBase

<RadzenTemplateForm TItem="IdentityRoleCreateDto" Data=@DialogFromOption.Model Submit="@(model => DialogFromOption.SubmitAsync(model, () => InvokeAsync(StateHasChanged)))" Style="max-height:calc(100vh - 200px); display: flex;flex-direction:column">
    <DialogFormLayout CancelClick="DialogFromOption.OnCancel" IsSaving="@DialogFromOption.IsSaving">
        <RoleInfoFields TDto="IdentityRoleCreateDto" Model="@DialogFromOption.Model" />
    </DialogFormLayout>
</RadzenTemplateForm>

@code {
    [Parameter]
    public DialogFromOption<IdentityRoleCreateDto> DialogFromOption { get; set; } = default!;

    public Create()
    {
        LocalizationResource = typeof(IdentityResource);
    }
}
